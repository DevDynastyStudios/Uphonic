{
  "WindowPadding": [14, 14],
  "FramePadding": [10, 8],
  "ItemSpacing": [10, 8],
  "ItemInnerSpacing": [8, 6],
  "IndentSpacing": 18,

  "WindowRounding": 8,
  "ChildRounding": 8,
  "FrameRounding": 6,
  "PopupRounding": 8,
  "ScrollbarRounding": 6,
  "GrabRounding": 6,
  "TabRounding": 6,

  "ScrollbarSize": 14,
  "GrabMinSize": 12,

  "WindowBorderSize": 1,
  "FrameBorderSize": 0,
  "PopupBorderSize": 1,

  "WindowTitleAlign": [0.5, 0.5],

  "AntiAliasedLines": true,
  "AntiAliasedFill": true,

  "Font": {
    "File": "Fonts/Nunito.ttf",
    "BoldFile": "Fonts/Nunito-Bold.ttf",
    "Size": 18,
    "OversampleH": 3,
    "OversampleV": 3,
    "RasterizerMultiply": 1.15
  }
}
